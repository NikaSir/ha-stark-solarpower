{
  "api_version": "nikas.home-assistant/integration-panel/v1",
  "id": "ups",
  "title": "UPS",
  "path": "/dashboard-ups",
  "parent_route": "/dashboard-infrastructure/overview",
  "icon": "mdi:battery-charging",
  "owner": "stark_solarpower",
  "expose_in_generated_ui": true,
  "preferred_view": "overview",
  "ui_version": "0.8.1",
  "template": {
    "name": "NikaS Integration Panel Template",
    "version": "1.0"
  },
  "shell": {
    "standard_version": "1.6",
    "height_locked_phone": true,
    "safe_area_owner": "integration_panel_once",
    "outer_page_scroll": false,
    "work_view_cache": "lazy_per_view_and_peer"
  },
  "header": {
    "grid_mobile_px": [52, "minmax(0,1fr)", 52],
    "grid_narrow_px": [48, "minmax(0,1fr)", 48],
    "title_alignment": "viewport_center",
    "minimum_height_px": 62,
    "minimum_height_px_narrow": 60,
    "title_px": 23,
    "title_px_narrow": 21,
    "subtitle_px": 14,
    "subtitle_px_narrow": 13,
    "show_brand_icon": false,
    "left_control": {
      "type": "home_assistant_system_menu",
      "icon": "mdi:menu",
      "label_visible": false,
      "touch_target_px": 44,
      "plaque_radius_px": 16,
      "icon_px": 25,
      "event": "hass-toggle-menu"
    },
    "actions": ["refresh"],
    "right_control": {
      "type": "refresh",
      "icon": "mdi:refresh",
      "touch_target_px": 44,
      "plaque_radius_px": 16,
      "icon_px": 25
    }
  },
  "device_context": {
    "selector": "persistent_below_header",
    "preserve_across_views": true,
    "reorder_selected": false,
    "content_scope": "selected_device_only",
    "mobile_rows": 1,
    "touch_target_px": 44
  },
  "navigation": {
    "header_menu": "home_assistant_system_sidebar",
    "primary_navigation": "full_width_fixed_bottom_tab_bar",
    "edge_attached": true,
    "floating": false,
    "safe_area": true,
    "touch_target_px": 52,
    "icon_px": 28,
    "label_px": 12,
    "label_weight": 700,
    "active_primary_percent": 11,
    "views": ["overview", "ups", "events", "history", "diagnostics"]
  },
  "zoom": {
    "scope": "selected_device_work_viewport",
    "engine": "native_vertical_at_100_transform_pan_above_100",
    "layout_during_gesture": "frozen",
    "pinch": true,
    "controls": [],
    "reset_gesture": "two_finger_double_tap",
    "snap_to_100_percent_range": [97, 103],
    "minimum_percent": 75,
    "maximum_percent": 200,
    "focal_point": true,
    "pan_when_enlarged": true,
    "pan_only_above_100_percent": true,
    "pan_axes": "overflow_only",
    "native_vertical_scroll_at_100_percent": true,
    "horizontal_scroll_at_100_percent": false,
    "origin_at_100_percent": [0, 0],
    "pan_engine": "single_transform_translation",
    "gesture_activation_guard": true,
    "persistence": "local_per_panel_and_device",
    "native_scale": ["header", "device_selector", "bottom_tab_bar"]
  },
  "overview": {
    "information_architecture": ["contextual_photographic_hero", "connection_and_freshness_indicator", "live_hero_metrics", "reserve_readiness", "battery_details"],
    "hero_scope": "selected_device_only",
    "power_flow": {
      "nodes": ["grid", "ups", "load", "battery"],
      "connectors": "none",
      "invented_power_values": false
    },
    "reserve_strip_placement": "below_hero",
    "key_metrics": ["input_voltage", "output_voltage", "output_frequency", "battery_capacity", "output_load", "battery_voltage", "battery_piece_number", "charger_temperature", "battery_remain_time"],
    "standalone_metric_row": false,
    "state_tiles": [],
    "connection_indicator": {
      "scope": "selected_device_only",
      "channel_states": ["cloud", "disconnected", "unknown"],
      "freshness_states": ["current", "stale", "unknown"],
      "channel_and_freshness_independent": true,
      "extended_telemetry_affects_primary": false
    },
    "power_mode_separate_from_connection": true
  },
  "events": {
    "scope": "selected_device_only",
    "entities": ["battery_mode", "cloud_telemetry", "data_freshness", "fault_mode", "extended_telemetry"]
  },
  "frontend_delivery": {
    "mode": "self_contained_bundle",
    "module": "stark-solarpower-panel-bundle.js",
    "assets": [
      "assets/stark-country-1000-online.png",
      "assets/stark-hero-internet-v051.webp",
      "assets/stark-hero-boiler-v051.webp",
      "assets/stark-hero-internet-v063.webp",
      "assets/stark-hero-boiler-v063.webp"
    ],
    "cache_busting": "query_ui_version",
    "runtime_previous_version_imports": false
  },
  "typography": {
    "profile": "mobile_readability",
    "primary_target": "iPhone Pro Max portrait",
    "safe_area_top": true,
    "safe_area_owner": "integration_panel_once",
    "header_title_px": 23,
    "header_subtitle_px": 14,
    "minimum_meaningful_text_px": 12,
    "maximum_meaningful_text_px": 25,
    "navigation_text_px": 12,
    "device_selector_text_px": 15,
    "hero_status_px": 25,
    "hero_metric_value_px": 19
  },
  "layout": {
    "mobile_horizontal_scroll": false,
    "mobile_content_columns": 1,
    "overview_state_tile_columns_mobile": 2,
    "overview_state_tile_columns_desktop": 4,
    "desktop_content_max_width_px": 1240,
    "desktop_selected_device_card_max_width_px": 820,
    "overview_mobile_hero_scene_px": 336,
    "overview_mobile_bottom_clearance_px": 16,
    "content_clears_bottom_navigation": true
  },
  "quality": {
    "stale_threshold_source": "backend",
    "refresh_feedback": true,
    "unrelated_hass_updates_skip_full_render": true,
    "all_view_telemetry_updates": "in_place_without_dom_replacement",
    "shell_mount": "once_per_panel_instance",
    "visited_views": "lazy_dom_cache",
    "height_locked_phone_shell": true,
    "pfc_status_mapped": true
  },
  "targets": {
    "primary": "iPhone Pro Max portrait",
    "secondary": ["iPad", "desktop"]
  }
}
