{
  "api_version": "nikas.home-assistant/integration-panel/v1",
  "id": "ups",
  "title": "UPS",
  "path": "/dashboard-ups",
  "parent_route": "/dashboard-infrastructure/overview",
  "icon": "mdi:battery-charging",
  "owner": "stark_solarpower",
  "expose_in_generated_ui": true,
  "preferred_view": "overview",
  "ui_version": "0.4.1",
  "template": {
    "name": "NikaS Integration Panel Template",
    "version": "1.0"
  },
  "header": {
    "grid_mobile_px": [52, "minmax(0,1fr)", 52],
    "grid_narrow_px": [48, "minmax(0,1fr)", 48],
    "title_alignment": "viewport_center",
    "show_brand_icon": false,
    "left_control": {
      "type": "application_menu",
      "icon": "mdi:menu",
      "label_visible": false,
      "touch_target_px": 44,
      "contains_parent_navigation": true
    },
    "actions": ["refresh"]
  },
  "application_menu": {
    "presentation": "left_drawer",
    "dismiss_on_backdrop": true,
    "parent_navigation": "/dashboard-infrastructure/overview",
    "device_selection": true,
    "refresh_all_ups": true,
    "browser_history": false
  },
  "device_context": {
    "selector": "persistent_below_header",
    "preserve_across_views": true,
    "reorder_selected": false,
    "content_scope": "selected_device_only",
    "mobile_rows": 1,
    "touch_target_px": 52
  },
  "navigation": {
    "exit_via": "application_menu_parent_item",
    "primary_navigation": "full_width_fixed_bottom_tab_bar",
    "edge_attached": true,
    "floating": false,
    "safe_area": true,
    "touch_target_px": 58,
    "views": ["overview", "diagnostics", "history"]
  },
  "overview": {
    "information_architecture": ["hero_status", "power_flow", "key_metrics", "state_tiles", "recent_events"],
    "hero_scope": "selected_device_only",
    "power_flow": {
      "nodes": ["grid", "ups", "load", "battery"],
      "line_mode_direction": "grid_to_ups_to_load",
      "battery_mode_direction": "battery_to_ups_to_load",
      "invented_power_values": false
    },
    "key_metrics": ["input_voltage", "output_voltage", "battery_capacity", "output_load"],
    "state_tiles": ["grid", "battery", "cloud", "freshness"],
    "recent_events": ["battery_mode", "cloud_telemetry", "data_freshness", "fault_mode"]
  },
  "frontend_delivery": {
    "mode": "self_contained_bundle",
    "module": "stark-solarpower-panel-bundle.js",
    "cache_busting": "query_ui_version",
    "runtime_previous_version_imports": false
  },
  "typography": {
    "profile": "mobile_readability",
    "primary_target": "iPhone Pro Max portrait",
    "header_title_px": 18,
    "header_subtitle_px": 14,
    "minimum_secondary_text_px": 14,
    "navigation_text_px": 14,
    "device_selector_text_px": 16,
    "hero_status_px_min": 26,
    "hero_metric_value_px": 19
  },
  "layout": {
    "mobile_horizontal_scroll": false,
    "mobile_content_columns": 1,
    "overview_state_tile_columns_mobile": 2,
    "overview_state_tile_columns_desktop": 4,
    "desktop_content_max_width_px": 1240,
    "desktop_selected_device_card_max_width_px": 820,
    "content_clears_bottom_navigation": true
  },
  "targets": {
    "primary": "iPhone Pro Max portrait",
    "secondary": ["iPad", "desktop"]
  }
}
